# Generate sqltree_opnames.h: a TK_ code -> "TK_NAME" table extracted
# from the patched amalgamation, so token numbering can never drift
# between the parser we build and the names we emit.
file(READ ${IN} txt)

set(out "/* generated by gen_opnames.cmake -- do not edit */\n")
set(best 0)
set(seen "")
string(REGEX MATCHALL "#define TK_[A-Z_0-9]+ +[0-9]+" defs ${txt})
foreach(d IN LISTS defs)
  string(REGEX REPLACE "#define (TK_[A-Z_0-9]+) +([0-9]+)" "\\1;\\2" pair ${d})
  list(GET pair 0 name)
  list(GET pair 1 num)
  list(FIND seen ${num} dup)
  if(dup EQUAL -1)
    list(APPEND seen ${num})
    string(APPEND out " [${num}] = \"${name}\",\n")
    if(num GREATER best)
      set(best ${num})
    endif()
  endif()
endforeach()
string(PREPEND out "#define SQT_N_TK ${best}\nstatic const char *const aTkName[] = {\n")
string(APPEND out "};\n")

file(WRITE ${OUT} "${out}")
message(STATUS "sqltree_opnames.h: ${best} token codes")
